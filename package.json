{
  "name": "outdoor-light",
  "version": "1.2.0",
  "description": "Add outdoor lights and walls to Foundry VTT.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "vite build --mode ${BUILD_MODE:-production}",
    "watch": "vite build --watch --mode ${BUILD_MODE:-development}"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^9.33.0",
    "@league-of-foundry-developers/foundry-vtt-types": "github:sylvercode/foundry-vtt-types#main",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.33.0",
    "rollup-plugin-copy": "^3.5.0",
    "sass": "^1.102.0",
    "typescript": "^5.8.3",
    "vite": "^8.2.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "allowScripts": {
    "github:sylvercode/foundry-vtt-types#main": true,
    "@parcel/watcher@2.5.1": true
  }
}
